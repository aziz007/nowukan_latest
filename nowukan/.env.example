# Copy to .env and fill in for your environment.
EXTERNAL_API_KEY=
EXTERNAL_API_BASE_URL=https://staging.nowukan.app/api/external

# Stripe — get these from the Stripe Dashboard (Developers → API keys / Webhooks).
# Use the sk_test_/pk_test_ keys while testing, sk_live_/pk_live_ once ready to go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used to build the success/cancel redirect URLs Stripe sends the browser back to.
SITE_URL=https://nowukan.io

# Newsletter signup (footer "Receive news and updates" form).
# Get RESEND_API_KEY from resend.com after verifying a sending domain there.
# NEWSLETTER_FROM_EMAIL must be an address on that verified domain (e.g. news@nowukan.io).
# NEWSLETTER_NOTIFY_EMAIL is the team inbox that receives each signup notification.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_NOTIFY_EMAIL=info@nowukan.io

# Sent to the CRM after a successful Stripe payment (see sendPaymentStatusToCrm in server.ts).
# Confirm these with the backend developer — the write endpoint is assumed.
CRM_BILLING_STATUS_PATH=/users/billing-status
CRM_BILLING_STATUS_METHOD=POST
CRM_PAID_STATUS=Paid

# --- Stripe checkout extras (all optional) ---
# Logo shown on the Stripe checkout page. Defaults to SITE_URL/brand/nowukan-logo.png
# (must be publicly reachable — i.e. the live site). Override if hosted elsewhere.
STRIPE_BRANDING_LOGO_URL=
# Product tax category for Stripe Tax (e.g. a txcd_... code). Leave empty to use the
# preset tax code set in Dashboard -> Settings -> Tax. Confirm the right code with your accountant.
STRIPE_TAX_CODE=

# --- Promo codes (CRM vouchers) ---
# Lookup uses EXTERNAL_API_BASE_URL + /vouchers/lookup with EXTERNAL_API_KEY.
# For production EXTERNAL_API_BASE_URL should be https://nowukan.app/api/external
#
# Turn on ONLY once the backend has deployed POST /vouchers/redeem { code, email }.
# While off: codes still give discounts, single-use codes are NOT used up after
# purchase, and 100%-off codes are refused with a "contact us" message.
CRM_VOUCHER_REDEEM_ENABLED=false
# Only if the backend uses a different path:
CRM_VOUCHER_REDEEM_PATH=/vouchers/redeem

# --- Buy Now page ---
# CRM billing statuses that mean "already has lifetime access" (comma-separated).
# Buy Now refuses a second purchase for these. Defaults to CRM_PAID_STATUS (Paid).
CRM_ALREADY_PAID_STATUSES=Paid

# --- Competition entries (Win Free Lifetime English) ---
# Entries are emailed here via Resend (uses RESEND_API_KEY + NEWSLETTER_FROM_EMAIL above).
COMPETITION_NOTIFY_EMAIL=info@nowukan.io
ENQUIRY_NOTIFY_EMAIL=info@nowukan.io
